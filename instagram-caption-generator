            <option value="question">Question Style</option>
        </select>
    </div>

    <button class="generate-btn" onclick="generateCaptions()" aria-label="Generate Captions Button">
        <span>✨</span> Generate Captions
    </button>

    <div class="results" id="results">
        <h2>✨ Your Caption Ideas</h2>
        <div id="captionList"></div>
        <button class="copy-all" onclick="copyAll()" aria-label="Copy All Generated Captions">
            📋 Copy All Captions
        </button>
    </div>

</div>

