<script>
function cleanTopic(topic){
    return topic.trim().replace(/\s+/g," ");
}

function generateCaptions(){
    const topicInput = document.getElementById("topic");
    const errorMsg = document.getElementById("errorMsg");
    const topic = cleanTopic(topicInput.value);
    const category = document.getElementById("category").value;
    const language = document.getElementById("language").value;
    const style = document.getElementById("style").value;

    if(!topic){
        errorMsg.style.display = "block";
        topicInput.style.borderColor = "#e11d48";
        topicInput.focus();
        return;
    } else {
        errorMsg.style.display = "none";
        topicInput.style.borderColor = "#cbd5e1";
    }

    let captions = [];

    if(language === "hinglish"){
        if(style === "short"){
            captions = [
                `${topic} ke sath ek khoobsurat din ✨`,
                `Bas ye moment hi kafi hai ❤️ ${topic}`,
                `${topic} — pure vibes! 🔥`,
                `Ye pal humesha yaad rahega ✨ ${topic}`
            ];
        } else if(style === "funny"){
            captions = [
                `${topic}... kyunki post kiye bina chain nahi mil raha tha 😂`,
                `POV: Jab aap kahin bahar jayein aur photo na lein, impossible! 😂📸`,
                `Planning perfect thi, baki sab bhagwan bharose 😂🔥`
            ];
        } else {
            captions = [
                `${topic} ✨ Aapka is baare me kya kehna hai?`,
                `Kya aapne kabhi aisa experience kiya hai? Comment me batao 👇`,
                `Sapno ko sach karne ka safar jari hai ✨`
            ];
        }
    } else if(language === "hindi"){
        if(style === "short"){
            captions = [
                `${topic} के साथ एक सुंदर क्षण ✨`,
                `यादों का एक नया पन्ना ❤️ ${topic}`,
                `जीवन के खूबसूरत पल ✨ ${topic}`
            ];
        } else if(style === "funny"){
            captions = [
                `${topic}... क्योंकि फोटो तो बनती है! 😂`,
                `दिखावे के लिए ही सही, फोटो अच्छी आ गई 😂📸`
            ];
        } else {
            captions = [
                `${topic} ✨ इस बारे में आपकी क्या राय है?`,
                `अपने सपनों को पूरा करने की राह पर ✨`,
                `हर दिन एक नई शुरुआत है 💫`
            ];
        }
    } else {
        if(style === "short"){
            captions = [
                `${topic} ✨`,
                `Making memories with ${topic} ❤️`,
                `${topic} — that's the vibe! 🔥`,
                `Just another beautiful moment. ✨ ${topic}`
            ];
        } else if(style === "funny"){
            captions = [
                `${topic}... because apparently I needed another reason to post. 😂`,
                `POV: You said you wouldn't post it, but here we are. 😭😂`,
                `${topic} looked too good to stay in my gallery. 😂📸`
            ];
        } else {
            captions = [
                `${topic} ✨ What do you think about this?`,
                `Would you try this? 👀 Tell me in the comments!`,
                `Believe in the process. Trust the journey. ✨`
            ];
        }
    }

    const hashtags = {
        general: "#Instagram #InstaPost #Trending #Explore #Viral",
        travel: "#Travel #TravelDiaries #Wanderlust #TravelLife #Explore",
        motivation: "#Motivation #Success #Mindset #Inspiration #Growth",
        fitness: "#Fitness #Workout #FitnessMotivation #Gym",
        business: "#Business #Entrepreneur #Success #Marketing",
        fashion: "#Fashion #Style #FashionInspo #OOTD",
        love: "#Love #LoveQuotes #Relationship #CoupleGoals",
        food: "#Food #Foodie #FoodLover #InstaFood",
        technology: "#Technology #Tech #Innovation #AI"
    };

    const tag = hashtags[category] || hashtags.general;
    captions = captions.map(caption => `${caption}\n\n${tag}`);

    displayCaptions(captions);
}

function displayCaptions(captions){
    const list = document.getElementById("captionList");
    list.innerHTML = "";

    captions.forEach((caption, index) => {
        const box = document.createElement("div");
        box.className = "caption-box";

        const top = document.createElement("div");
        top.className = "caption-top";

        const number = document.createElement("span");
        number.className = "caption-number";
        number.textContent = `Caption ${index + 1}`;

        const button = document.createElement("button");
        button.className = "copy-btn";
        button.textContent = "Copy";
        button.setAttribute("aria-label", `Copy caption number ${index + 1}`);

        button.onclick = function(){
            navigator.clipboard.writeText(caption);
            button.textContent = "Copied ✓";
            setTimeout(() => { button.textContent = "Copy"; }, 1500);
        };

        top.appendChild(number);
        top.appendChild(button);

        const text = document.createElement("div");
        text.className = "caption-text";
        text.textContent = caption;

        box.appendChild(top);
        box.appendChild(text);
        list.appendChild(box);
    });

    document.getElementById("results").style.display = "block";
    document.getElementById("results").scrollIntoView({ behavior: "smooth", block: "start" });
}

function copyAll(){
    const captions = document.querySelectorAll(".caption-text");
    let all = [];
    captions.forEach(caption => { all.push(caption.textContent); });
    navigator.clipboard.writeText(all.join("\n\n--------------------\n\n"));
    alert("All captions copied successfully! ✓");
}
</script>

